# Backend only. Never put these variables in iOS, Android, Flutter, or browser bundles.
DATABASE_URL=
R3_PUSH_ENABLED=false
TMNT_ALLOWED_PUSH_ENVIRONMENTS=test
TMNT_ONESIGNAL_APPS_JSON={}
TMNT_TEMPLATES_JSON={}
TMNT_BATCH_SIZE=3
TMNT_POSTHOG_PROJECT_KEY=
# Required when PostHog is enabled; must be shared by worker and SDK emitter.
TMNT_ANALYTICS_HASH_SECRET=
TMNT_POSTHOG_HOST=https://us.i.posthog.com
# Only required if exposing the optional HTTP tickHandler:
CRON_SECRET=

# RIVERENGINE v2.5 PostHog A/B. All backend-only, OFF by default.
RIVERENGINE_AB_ENABLED=false
RIVERENGINE_AB_ALLOW_PROD=false
RIVERENGINE_POSTHOG_PROJECT_KEY=
# Hash secret must be SAME as TMNT_ANALYTICS_HASH_SECRET for cross-pipeline analytics.
RIVERENGINE_POSTHOG_HOST=https://us.i.posthog.com
# Provider uses posthog-node; SDK must be installed server-side.
# Never put PostHog tokens or the hashing secret in mobile/web bundles.

# v2.8 — optional Graphile Worker / MABWiser; all disabled until approved in backend QA.
RIVER_GRAPHILE_ENABLED=false
RIVER_GRAPHILE_DATABASE_URL=
RIVER_GRAPHILE_JOB_SECRET=
RIVER_POSTHOG_PROJECT_KEY=
RIVER_ANALYTICS_HASH_SECRET=
RIVER_BANDIT_ENABLED=false
RIVER_BANDIT_SIGNING_SECRET=

# v2.9 Observer. Separate backend-only credentials per tenant/app/environment.
RIVER_OBSERVER_BASE_URL=
RIVER_OBSERVER_SCOPE=
RIVER_OBSERVER_SIGNING_SECRET=
RIVER_OBSERVER_EXPERIMENT_FLAGS=
# Dedicated QA worker. Never enable blindly in production.
RIVER_VALUE_OUTBOX_ENABLED=false
RIVER_VALUE_OUTBOX_ALLOW_PRODUCTION=false
RIVER_VALUE_OUTBOX_HASH_SECRET=
RIVER_POSTHOG_PROJECT_KEY=
RIVER_POSTHOG_HOST=https://us.i.posthog.com
# Requires explicit operator approval before any prod job is claimed.
RIVER_VALUE_OUTBOX_PRODUCTION_APPROVED=false

# v3.0 churn; OFF by default and separate from notification delivery.
RIVER_CHURN_ENABLED=false
RIVER_CHURN_ALLOW_PRODUCTION=false
# Only use a vetted, offline-trained model. No model = uncalibrated heuristic risk index.
RIVER_CHURN_VALIDATED_MODEL_PATH=
RIVER_CHURN_SCOPE=
RIVER_CHURN_DAY=

# INSTANTENGINE v3.1 — Optional independent privacy maintenance; OFF by default.
INSTANT_PURGE_ENABLED=false
INSTANT_PURGE_ALLOW_PRODUCTION=false
# INSTANT_CHURN_SCOPE=tenant/app/test
# INSTANT_CHURN_ENABLED=false
# INSTANT_CHURN_ALLOW_PRODUCTION=false
# Existing RIVER_CHURN_* variables remain supported as fallback for the churn scorer.
